{
  "name": "tarbert-street-dental",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node tooling/build-site.mjs && sanity build dist/studio -y",
    "start": "node tooling/serve.mjs",
    "dev": "npm run build && npm start",
    "studio": "sanity dev",
    "seed": "sanity exec tooling/seed.mjs --with-user-token",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@sanity/client": "8.6.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanity": "6.16.0",
    "styled-components": "^6.1.19"
  },
  "overrides": {
    "adm-zip": "0.6.1",
    "js-yaml": "3.15.2",
    "smol-toml": "1.9.0",
    "typeid-js": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
